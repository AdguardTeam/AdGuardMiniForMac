.Title {
    &_payedTitle {
        margin-top: var(--m-xs);

        &_text {
            font-size: 14px;
        }
    }

    &_wrongOsTitle {
        margin-top: var(--m-s);
    }

    &_notSupportedTitle {
        margin-top: var(--m-s);
    }

    &_button {
        display: inline;
        text-decoration: underline;

        &:hover {
            text-decoration: none;
        }
    }
}
