<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>MEExtensionCapabilities</key>
			<array>
				<string>MEContentBlocker</string>
			</array>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.email.extension</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).MailExtension</string>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>AdGuard Mail Tracking Protection</string>
	<key>NSHumanReadableDescription</key>
	<string>Lets AdGuard Mini block hidden trackers in your emails</string>
</dict>
</plist>
