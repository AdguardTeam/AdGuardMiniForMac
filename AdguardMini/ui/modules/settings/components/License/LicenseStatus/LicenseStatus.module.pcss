.LicenseStatus {
    &_container {
        &_icon {
        color: var(--accent-main-default);
        text-decoration-color: var(--accent-main-default);
    }
    }
}

.LicenseStatusDesc {
    &_container {
        color: var(--neutral-dark-default);
    }

    &_warning {
        color: var(--attention-main-default);
    }

    &_blocked {
        color: var(--error-main-default);
    }
}

.LicenseStatusAction {
    &_container {
        padding-left: 52px;
        margin-bottom: var(--m-l);
    }
}