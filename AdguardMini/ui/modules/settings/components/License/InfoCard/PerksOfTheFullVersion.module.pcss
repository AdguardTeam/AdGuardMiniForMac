.PerksOfTheFullVersion {
    margin-top: var(--m-s);

    &_tableHeader {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        align-items: center;
        width: 100%;
    }

    &_title {
        padding-right: var(--m-s);
    }

    &_case {
        width: auto;
        color: var(--text-description-description-default);
        text-align: center;
        vertical-align: middle;
    }

    &_item {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        align-items: center;
        padding: var(--m-xs) 0 var(--m-xs) var(--m-s);

        &_title {
            padding-right: var(--m-s);
        }

        &__valid {
            width: auto;
            color: var(--text-links-link-default);
            text-align: center;
            vertical-align: middle;
        }

        &__invalid {
            width: auto;
            color: var(--text-links-error-link-default);
            text-align: center;
            vertical-align: middle;
        }

        &__bordered {
            border-top: 1px solid var(--stroke-dividers-item-divider-default);
        }

        &__bottomMargin {
            margin-bottom: var(--m-xxs);
        }
    }

    &_button {
        width: max-content;
        max-width: max-content;
        padding: var(--m-xs) var(--m-m);
    }
}