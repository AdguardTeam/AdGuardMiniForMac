.Filter {
    &_desc {
        color: var(--text-description-description-default);
    }

    &_link {
        cursor: pointer;
        text-decoration: underline;

        /* Inline text action: the floating offset keeps the ring clear of the text. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;
    }

    &_homepage {
        padding-top: 4px;
    }

    &_warning {
        padding-top: 4px;
    }
}