.HowItWorks {
    &_block {
        margin: 0 var(--m-s) var(--m-m);
        padding: var(--m-m) var(--m-s);
        background: var(--background-additional-default);
        border-radius: var(--border-radius);

        &_title {
            margin-bottom: var(--m-xs);
        }
    }
}
