.Troubleshooting {
    &_block {
        margin: 0 var(--m-s) var(--m-m);
        padding: var(--m-m) var(--m-s);
        background: var(--fills-backgrounds-page-background-additional-default);
        border-radius: var(--border-radius);

        &_title {
            margin-bottom: var(--m-xs);
        }

        &_desc {
            margin-bottom: var(--m-s);
        }
    }

    &_link {
        color: inherit;
        cursor: pointer;

        /* Inline text action: the floating offset keeps the ring clear of the text. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;
    }

    &_link_disabled {
        color: inherit;
    }

    &_list {
        padding-inline-start: var(--m-m);
    }

    /* Only the host list is copyable; the rest of the troubleshooting text stays non-selectable. */
    &_domains,
    &_domains * {
        user-select: text;
        -webkit-user-select: text;
    }

    /* Zero-width selection root leaves WebKit no line-break gap to fill; hosts stay nowrap. */
    &_domains {
        display: block;
        width: 0;
        position: relative;
        white-space: nowrap;
    }
}
