.Title {
    &_payedTitle {
        margin-top: var(--m-xs);

        /*
         * Page-title notices are 16px in the design (the same slot as the
         * rule-limit banner); the hook's own type is the 14px row size.
         */
        &_text {
            font-size: var(--ft-l);
        }
    }

    &_wrongOsTitle {
        margin-top: var(--m-s);
    }

    &_notSupportedTitle {
        margin-top: var(--m-s);
    }

    &_button {
        display: inline;
        text-decoration: underline;
        text-decoration-color: var(--attention-main-default);

        &:hover {
            text-decoration: none;
        }
    }
}
