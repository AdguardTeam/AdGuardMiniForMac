html[theme="dark"] {
    --paywall-default-background-image: url('./Images/dark.png');
    --paywall-trial-expired-background-image: url('./Images/expiredTrialDark.png');
    --paywall-license-expired-background-image: url('./Images/expiredTrialDark.png');
}

html[theme="light"] {
    --paywall-default-background-image: url('./Images/light.png');
    --paywall-trial-expired-background-image: url('./Images/expiredTrialLight.png');
    --paywall-license-expired-background-image: url('./Images/expiredLicense.png');
}

.Paywall {
    position: fixed;
    width: auto;
    height: auto;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--zi-paywall);

    &_backdrop {
        position: absolute;
        inset: 0;
        background-color: var(--modal-background);
        z-index: var(--zi-paywall);
    }

    &_bg {
        z-index: var(--zi-paywall-modal);
        width: 736px;
        height: 576px;

        position: absolute;
        overflow: hidden;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 16px;

        display: flex;
        flex-direction: column;
        justify-content: center;

        background: var(--background-main-default);
        background-size: contain;
        background-repeat: no-repeat;
        background-origin: border-box;

        padding: var(--m-m) var(--m-l);

        &__defaultImage {
            background-image: var(--paywall-default-background-image);
            background-position: right;
        }

        &__trialExpiredImage {
            background-image: var(--paywall-trial-expired-background-image);
            background-position: left;
        }

        &__licenseExpiredImage {
            background-image: var(--paywall-license-expired-background-image);
            background-position: left;
        }
    }

    &_container {
        position: relative;
        height: auto;
        width: 396px;
        padding-top: var(--m-m);
    
        &__left {
            margin-right: auto;
        }

        &__right {
            width: 366px;
            margin-left: auto;
            margin-right: 0;
        }
    }

    &_cross {
        position: absolute;
        top: var(--m-s);
        right: var(--m-s);
        cursor: pointer;
        color: var(--neutral-dark-default);
    }

    &_title {
        margin-bottom: var(--m-xs);
    }
    
    &_desc {
        color: var(--neutral-dark-default);
        margin-bottom: var(--m-s);
        max-width: 370px;
    }

    &_offer {
        position: absolute;
        right: var(--m-s);
        bottom: 16px;
        display: flex;
        align-items: flex-start;
        gap: var(--m-xxs);
        width: 280px;
        padding: var(--m-xs) var(--m-xs) var(--m-xs) var(--m-s);
        border: 1px solid var(--accent-main-default);
        border-radius: var(--border-radius);
        background: var(--background-main-default);
        color: var(--neutral-black-default);
        box-shadow: 4px 4px 8px rgba(0, 0, 0, 0.10), 8px 8px 24px rgba(0, 0, 0, 0.20);
        animation: 0.2s ease-out offer-appear;

        /* The right-content layout leaves the illustration side free, so the card mirrors there. */
        &__left {
            right: auto;
            left: var(--m-s);
        }

        &_text {
            display: flex;
            flex: 1 0 0;
            flex-direction: column;
            justify-content: center;
            gap: var(--m-xxxs);
            min-width: 0;
            overflow-wrap: break-word;
        }

        &_close {
            flex-shrink: 0;
            color: var(--neutral-dark-default);
        }
    }

    &_advantages {
        margin-bottom: var(--m-xxs);

        &_advantage {
            display: flex;
            align-items: center;
            padding-top: var(--m-xxs);
            padding-bottom: var(--m-xxs);
            gap: var(--m-xs);

            &_icon {
                color: var(--accent-main-default);
            }
        }
    }

    &_actions {
        margin-top: auto;
        box-sizing: content-box;
        padding: 0;
        width: 396px;

        &_loader {
            padding-top: 18px;
            padding-bottom: 18px;
            &_icon {
                margin-left: auto;
                margin-right: auto;
            }
        }
    
        &_container {
            gap: var(--m-xs);
        }
    
        &_button {
            max-width: 364px;
            margin-bottom: var(--m-xs);
        }

        &_submit {
            margin-top: var(--m-m);
        }
    }

    &_footer {
        margin-top: var(--m-m);
        width: 364px;
        text-align: center;

        &_btn {
            display: inline-block;
            padding: 2px var(--m-xxs);
            margin: 0 auto;
            color: var(--neutral-dark-default);
            &:hover {
                color: var(--accent-main-hover);
            }
        }

        &_link {
            display: inline-block;
            margin: 0 auto;
            padding: 2px var(--m-xxs);
            cursor: pointer;
            >a {
                transition: color linear 0.1s;
            }

            &:hover {
                >a {
                    color: var(--accent-main-hover);
                }
            }
        }
    }
}

@keyframes offer-appear {
    from {
        opacity: 0;
        transform: translate(0, 100%);
    }

    to {
        opacity: 1;
        transform: translate(0);
    }
}