.SubscriptionPrices {
    &_btn {
        max-width: 364px;
        text-align: left;
        display: flex;
        padding: 10px var(--m-xs);
        border-color: var(--neutral-blend-default);
        color: var(--neutral-dark-default);
        min-height: 44px;
        margin-bottom: var(--m-xs);

        &_icon {
            margin: 0 auto;
            color: var(--accent-main-default);
            opacity: 0;
        }

        &_text {
            max-width: 320px;
            width: 320px;
            margin: auto 0;
        }

        /* Only the selected plan is semibold; pinned so the button rule cannot override it. */
        & > .SubscriptionPrices_btn_text {
            font-weight: var(--fw-normal);
        }

        &__active {
            background-color: var(--success-blend-default);
            border-color: var(--accent-main-default);
            color: var(--neutral-black-default);

            & > .SubscriptionPrices_btn_icon {
                opacity: 1;
            }

            & > .SubscriptionPrices_btn_text {
                font-weight: var(--fw-semibold);
            }
        }

        &:hover {
            background-color: var(--success-blend-default);
        }
    }

    &_offer {
        text-decoration: line-through;
    }
}