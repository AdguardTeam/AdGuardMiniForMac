.About {
    &_textSpace {
        margin-bottom: var(--m-xxxs);
        user-select: text;
        -webkit-user-select: text;
    }

    &_version {
        display: flex;
        align-items: center;

        &_copy {
            margin-left: auto;
            margin-top: -4px;
        }    
    }

    &_libraries {
        cursor: pointer;

        @mixin focus-ring;
    }

    &_dependencies {
        display: flex;
        cursor: pointer;
        margin-top: var(--m-s);

        @mixin focus-ring;

        &_arrow {
            margin-left: auto;
            transform: rotate(-90deg);

            &__active {
                margin-left: auto;
                transform: rotate(90deg);
            }
        }

        &_item {
            color: var(--neutral-dark-default);
            margin-bottom: 0;
        }
    }

    &_description {
        margin-top: var(--m-l);
        margin-bottom: var(--m-m);
    }

    &_updateSection {
        margin-top: var(--m-xs);
    }

    &_update {
        margin-bottom: var(--m-l);
        margin-top: -16px;
        &_requestUpdate {
            display: inline;
            color: var(--accent-main-default);
            cursor: pointer;
            text-decoration: underline;

            /*
             * Keyboard focus indicator: an inline, link-styled text action,
             * so the floating offset keeps the ring clear of the text.
             */
            --focus-ring-offset: var(--focus-ring-offset-floating);

            @mixin focus-ring;

            &:hover {
                text-decoration: none;
            }
        }
    }

    &_rights {
        color: var(--neutral-light-default);
    }

    &_link {
        display: block;
        width: min-content;
        white-space: nowrap;
        padding: 10px 0;
    }
}
