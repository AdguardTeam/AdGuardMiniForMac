@keyframes rotate { 
    from { transform: rotate(0deg); } 
    to { transform: rotate(360deg); }
}

.SettingsItem {
    display: flex;
    min-height: 28px;

    /*
     * Keyboard focus indicator for the container-as-button path (only those
     * rows have `tabIndex`); the contained preset wraps the padded row, and
     * the `Button` pin keeps nested buttons on the button default.
     */
    --focus-ring-offset: var(--focus-ring-offset-contained);

    @mixin focus-ring;

    &__pointer {
        cursor: pointer;
    }

    &__hover {
        &:hover {
            border-radius: 8px;
            background: var(--background-main-hover);
        }
    }

    &_defaultHovered {
        border-radius: 8px;
        background: var(--background-main-hover);
    }

    &_title {
        /* Grow to absorb the free space so the trailing control (switch,
           chevron) is pinned to a consistent right edge, matching the design. */
        flex: 1 1 auto;
    }

    &_container {
        box-sizing: content-box;
        padding: var(--m-s);

        &__route {
            height: auto;
        }

        &_newLabel {
            height: 20px;
            border-radius: 6px;
            padding: 3px 8px;
            margin-right: auto;
            margin-top: -1px;
            background: var(--accent-main-default);
            color: var(--special-static-white-default);
            text-align: center;
        }

        &_line {
            display: flex;
            min-height: 25px;
            align-items: center;

            /*
             * Keyboard focus indicator for the route-title path (`role` and
             * `tabIndex` are set only when `routeName` is present, so a plain
             * title line can never match); the contained preset wraps the row.
             */
            --focus-ring-offset: var(--focus-ring-offset-contained);

            @mixin focus-ring;

            &_icon {
                margin-right: var(--m-xs); 

                &__green {
                    color: var(--accent-main-default);
                }

                &__orange {
                    color: var(--attention-main-default);
                }

                &__red {
                    color: var(--error-main-default);
                }

                &__gray {
                    color: var(--neutral-black-default);
                }

                &__rotate {
                    animation: 2s infinite linear rotate;   
                }
            }

            &__negativeMargin {
                margin-top: -2px;
            }

            &_text {
                margin-right: var(--m-xxs);
            }
        }
        
        &_desc {
            &_text {
                color: var(--neutral-dark-default);
            }

            &__icon {
                padding-left: 36px;
            }
        }

        &_children {
            height: auto;
        }

        &__withRoute {
            padding-left: var(--m-s);
            cursor: pointer;
        }
    }
}

.SettingsItemLink {
    &_arrow {
        transform: rotate(180deg);
        color: var(--neutral-dark-default);
        margin-left: auto;

        &__external {
            color: var(--accent-main-default);
        }
    }
}
