.Settings {
    &_sectionTitle {
        box-sizing: content-box;
        padding: var(--m-l) var(--m-s) var(--m-s);
    }

    &_testIcon {
        transform: rotate(-90deg);
        margin-left: var(--m-xs);
    }

    &_pseudoSelect {
        display: flex;
    }

    &_enabled {
        color: var(--neutral-dark-default);

        &_warning {
            color: var(--attention-main-default);
            cursor: pointer;
        }
    }

    &_text {
        line-height: 24px;
    }

    &_container {
        padding: var(--m-s);
    }

    &_firstLine {
        display: flex;
        height: 28px;
    }

    &_updateInterval {
        color: var(--attention-main-default);
        > div {
            display: inline;
            cursor: pointer;
            text-decoration: underline;
        }
    }

    &_button {
        display: inline;
        text-decoration: underline;
        text-decoration-color: var(--attention-main-default);

        &:hover {
            text-decoration: none;
        }
    }

    &_resetWarning {
        padding-top: var(--m-xs);
    }

    &_telemetryModalLink {
        text-decoration-line: underline;
        cursor: pointer;
        display: inline;
        width: max-content;
        color: var(--accent-main-default);
        text-decoration-color: var(--accent-main-default);

        /* Inline text action: the floating offset keeps the ring clear of the text. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;

        &:hover {
            text-decoration: none;
        }
    }

    &_experimentalLink {
        display: inline-block;
        width: max-content;
        padding-top: var(--m-xxxs);
        color: var(--accent-main-default);
        text-decoration: none;
        cursor: pointer;

        /* Inline text action: the floating offset keeps the ring clear of the text. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;
    }

    &_experimentalWarning {
        padding-top: var(--m-xxxs);
    }

    &_underline {
        text-decoration: underline;

        &:hover {
            text-decoration: none;
        }
    }
}
