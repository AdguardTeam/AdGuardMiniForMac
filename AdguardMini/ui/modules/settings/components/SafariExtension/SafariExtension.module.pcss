.SafariExtension {
    &_settings {
        padding-right: var(--m-s);
    }

    &_rules {
        color: var(--neutral-dark-default);

        &__orange {
            color: var(--attention-main-default);
            text-decoration-color: var(--attention-main-default);
        }

        &__red {
            color: var(--error-main-default);
            text-decoration-color: var(--error-main-default);
        }

        &_link {
            display: inline;
            text-decoration-line: underline;
            cursor: pointer;

            /* Inline text action: the floating offset keeps the ring clear of the text. */
            --focus-ring-offset: var(--focus-ring-offset-floating);

            @mixin focus-ring;
        }
    }

    &_link {
        padding-top: var(--m-xxs);
        margin-top: var(--m-xs);
    }
}