.Tooltip {
    position: absolute;
    z-index: var(--zi-above-extra);

    &_tooltip {
        padding: 8px 16px;
        font-size: 14px;
        background-color: var(--background-elevated-default);
        color: var(--neutral-black-default);
        border-radius: 5px;
        box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.15);
    }
}
