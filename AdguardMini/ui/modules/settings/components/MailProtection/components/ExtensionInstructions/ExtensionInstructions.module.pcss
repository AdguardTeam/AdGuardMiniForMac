.ExtensionInstructions {
    &_block {
        &_title {
            padding: var(--m-l) var(--m-s) var(--m-s);
            box-sizing: content-box;
        }
    }

    &_list {
        margin: 0;
        padding: 0 var(--m-s) 0 var(--m-l);
        box-sizing: content-box;
        color: var(--neutral-dark-default);
    }

    &_link {
        padding: var(--m-xxs) var(--m-s) var(--m-l);
        box-sizing: content-box;
    }
}
