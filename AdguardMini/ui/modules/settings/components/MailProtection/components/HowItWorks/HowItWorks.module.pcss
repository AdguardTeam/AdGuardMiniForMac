.HowItWorks {
    &_block {
        &_title {
            padding: var(--m-l) var(--m-s) var(--m-s);
            box-sizing: content-box;
        }

        &_desc {
            padding: 0 var(--m-s) var(--m-m);
            box-sizing: content-box;
        }

        &_desc:last-child {
            padding-bottom: var(--m-l);
        }
    }
}
