.SupportContact {
    &_content {
        margin-top: var(--m-s);
    }

    &_input {
        margin-bottom: var(--m-m);

        &_addLogsDesc {
            color: var(--neutral-dark-default);
        }
    }

    &_textarea {
        margin-bottom: var(--m-m);
        
        &_inner {
            height: 150px;
        }
    }

    &_submit {
        width: 278px;
    }

    &_failedSubmitLink {
        color: var(--accent-main-default);
        text-decoration: underline;
        cursor: pointer;

        /* Text link: the floating offset keeps the ring clear of the text. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;

        &:hover {
            color: var(--accent-main-default);
            text-decoration: none;
        }
    }
}