.HealthCheck {
    padding: 0 var(--m-s);

    &_listitem {
        margin-top: var(--m-m);
    }
    
    &_showMore {
        margin: var(--m-xxs) 0;
        padding: var(--m-xs) var(--m-s);
        min-height: 48px;
        box-sizing: border-box;
        display: flex;
        align-items: center;

        &_icon {
            margin-left: var(--m-xxxs);
            transform: rotate(-90deg);
            transition: transform 0.3s ease;

            &__active {
                transform: rotate(90deg);
            }
        }

    }
}

