.MenuItem {
    &_item {
        width: 224px;
        display: flex;
        padding: var(--m-xxs);
        border-radius: var(--border-radius);
        cursor: pointer;
        align-items: center;

        &:hover {
            background: var(--background-main-default);
        }

        &__active {
            background: var(--background-main-default);
        }

        /*
         * Keyboard focus indicator: the item is a menu row, so the contained
         * (inset) offset wraps the padded row.
         */
        --focus-ring-offset: var(--focus-ring-offset-contained);

        @mixin focus-ring;
    }

    &_text {
        margin-bottom: 0;
    }

    &_icon {
        margin-right: var(--m-xs);
        color: var(--accent-main-default);
        width: 24px;
        height: 24px;
    }

    &_iconNew {
        margin: * 0 * var(--m-xxxs);
        color: var(--accent-main-default);
        width: 24px;
        height: 24px;
    }

    &_rightIcon {
        margin-left: auto;
        color: var(--accent-main-default);
        width: 24px;
        height: 24px;
    }
}
