.Menu {
    background-color: var(--fills-buttons-secondary-button-hovered);
    display: flex;
    flex-flow: column;

    &_logo {
        margin: var(--m-xxs) var(--m-xxs) var(--m-xs);
    }

    &_getFullVersion {
        padding: var(--m-xxs) 0;

        &_button {
            width: 100%;
            min-height: var(--m-xl);
        }
    }

    &_menuItems {
        padding-top: var(--m-s);

        &_delimiter {
            padding: var(--m-m) 0 var(--m-xs) var(--m-xs);
        }
    }

    /* Keeps the products entry pinned to the bottom of the menu. */
    &_spacer {
        flex: 1;
    }
}
