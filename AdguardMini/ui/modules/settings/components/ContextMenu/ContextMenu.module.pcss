.ContextMenu {
    position: relative;
    width: 24px;
    height: 24px;

    &_context {
        z-index: var(--zi-above-extra);
        position: absolute;
        width: 221px;
        border-radius: var(--border-radius);
        background-color: var(--background-main-default);
        right: 0px;
        top: 30px;
        box-shadow: var(--bs-big);
        overflow: hidden;

        &__tooltip {
            background-color: var(--background-elevated-default);
            width: max-content;

            .ContextMenu_action:hover {
                background: inherit;
            }
        }
    }

    &_action {
        border-bottom: 1px solid var(--neutral-blend-default);
        padding: var(--m-s);
        box-sizing: content-box;
        cursor: pointer;
        min-height: 26px;
        display: flex;
        align-items: center;

        /*
         * Keyboard focus indicator: a menu row inside the rounded panel, so
         * the contained preset keeps the ring within the row.
         */
        --focus-ring-offset: var(--focus-ring-offset-contained);

        @mixin focus-ring;

        &:hover {
            background: var(--background-elevated-hover);
        }

        &:last-of-type {
            border-bottom: 0;
        }
    }
}
