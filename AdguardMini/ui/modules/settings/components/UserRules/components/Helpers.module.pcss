.block {
    color: var(--error-main-default) !important;
}

.unblock {
    color: var(--accent-main-default) !important;
}

.custom {
    color: var(--neutral-dark-default) !important;
}

.comment {
    color: var(--neutral-dark-default) !important;
}

.muted {
    color: var(--neutral-dark-default) !important;
}