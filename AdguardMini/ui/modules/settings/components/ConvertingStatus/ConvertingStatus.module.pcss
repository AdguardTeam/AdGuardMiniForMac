@keyframes runner { 
    from {
        left: -200px;
    } 
    to {
        left: 700px;
    }
}

.ConvertingStatus {
    &_tooltipContainer {
        height: 4px;
        position: relative;
        width: auto;
        overflow: hidden;
        display: flex;
    }

    &_background {
        background: var(--background-additional-default);

        &:hover {
            background: var(--background-additional-hover);
        }
        
    }

    &_runner {
        width: 200px;
        height: 4px;
        position: relative;
        background: var(--accent-main-default);
        animation: 4s infinite linear runner
    }
}