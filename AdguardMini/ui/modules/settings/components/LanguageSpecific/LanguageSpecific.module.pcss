.LanguageSpecific {
    /*
     * The page is a column that fills the window (its parent has a definite
     * height), so the empty state can grow into the remaining space and
     * center its content, like the design's placeholder.
     */
    display: flex;
    flex-direction: column;
    min-height: 100%;

    &_search {
        margin: var(--m-s);
    }

    &_emptyResult {
        /*
         * The design's placeholder fills the page's remaining height and
         * centers the icon and text (padding 64/64/48/48, centered on both
         * axes). `flex: 1 0 auto` grows it without ever shrinking below the
         * icon and caption.
         */
        display: flex;
        flex: 1 0 auto;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 48px 64px;

        &_icon {
            width: 64px;
            height: 64px;
        }

        &_text {
            color: var(--neutral-dark-default);
            text-align: center;
        }
    }
    
    &_mainControl {
        margin-bottom: var(--m-s);
    }
}
