.LanguageSpecific {
    &_search {
        margin: var(--m-s) var(--m-s) var(--m-l);
    }

    &_emptyResult {
        height: auto;
        width: auto;

        &_icon {
            width: 64px;
            height: 64px;
            margin-left: auto;
            margin-right: auto;
            margin-top: auto;
        }

        &_text {
            color: var(--stroke-icons-gray-icons-default);
            text-align: center;
            margin-bottom: auto;
        }
    }
    
    &_mainControl {
        margin-bottom: var(--m-s);
    }
}
