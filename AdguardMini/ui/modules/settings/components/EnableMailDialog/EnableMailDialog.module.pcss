.EnableMailDialog {
    &_image {
        display: block;
        width: 220px;
        height: auto;
        margin: 0 auto var(--m-xxs);
    }

    &_list {
        margin: 0;
        padding-left: var(--m-m);
        color: var(--neutral-dark-default);
    }

    &_privacy {
        margin-top: var(--m-m);
        color: var(--neutral-dark-default);
    }
}
