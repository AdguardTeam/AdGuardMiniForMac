.StepHeader {
    &_container {
        height: 40px;
        padding-left: var(--m-s);
        display: flex;
        align-items: center;
    }

    &_progress {
        display: flex;
        margin: 0 auto;
            gap: var(--m-xxs);
        &_step {
            width: 32px;
            height: 4px;
            border-radius: var(--border-radius);
            background-color: var(--background-additional-hover);
        
            &__active {
                background-color: var(--accent-main-default);
            }
        }
    }

    &_skip {
        color: var(--neutral-dark-default);
    }
}