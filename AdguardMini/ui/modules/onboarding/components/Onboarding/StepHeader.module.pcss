.StepHeader {
    &_container {
        height: 40px;
        display: flex;
        align-items: center;
    }

    &_progress {
        display: flex;
        margin: 0 auto;
            gap: var(--m-xxs);
        &_step {
            width: 32px;
            height: 4px;
            border-radius: var(--border-radius);
            background-color: var(--fills-backgrounds-page-background-additional-hovered);
        
            &__active {
                background-color: var(--fills-buttons-main-button-default);
            }
        }
    }

    &_skip {
        color: var(--text-breadcrumbs-default);
    }
}