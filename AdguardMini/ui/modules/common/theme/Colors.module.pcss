/* Keep updated with ./default/colors.css */
/* Sometimes useful for dynamic color setting */

.adgGreen {
    color: var(--accent-main-default);
}

.adgGreenHover {
    color: var(--accent-main-hover);
}

.red {
    color: var(--error-main-default);
}

.orange {
    color: var(--attention-main-default);
    text-decoration-color: var(--attention-main-default);
}

.orangeHover {
    color: var(--attention-main-hover);
}

.linkGreen {
    color: var(--accent-main-default) !important;
}