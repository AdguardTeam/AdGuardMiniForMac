.greenIcon {
    color: var(--accent-main-default);

    &:hover {
        color: var(--accent-main-hover);
    }
}

.grayIcon {
    color: var(--neutral-dark-default);

    &:hover {
        color: var(--neutral-dark-default);
    }
}

.whiteIcon {
    color: #FFFFFF;

    &:hover {
        color: #FFFFFF;
    }
}

.redIcon {
    color: var(--error-main-default);

    &:hover {
        color: var(--error-main-hover);
    }
}

.redText {
    color: var(--error-main-default) !important;

    &:hover {
        color: var(--error-main-hover) !important;
    }
}

.orangeText {
    color: var(--attention-main-default) !important;

    &:hover {
        color: var(--attention-main-hover) !important;
    }
}

.redSubmit {
    background: none;
    background-color: var(--error-main-default);

    &:hover {
        background-color: var(--error-main-hover);
    }
}

.greenSubmit {
    background: none;
    background-color: var(--accent-main-default);

    &:hover {
        background-color: var(--accent-main-hover);
    }
}

.permanentThemedSubmit {
    background: none;
    background-color: var(--background-main-default);
    color: var(--neutral-black-default) !important;

    &:hover {
        background-color: var(--background-main-default);
        color: var(--neutral-black-default) !important;
    }
}

.payButton {
    color: var(--attention-main-default);
    display: inline;
    text-decoration: underline;

    &:hover {
        text-decoration: none;
    }
}

.underline {
    text-decoration: underline;

    &:hover {
        text-decoration: none;
    }
}
