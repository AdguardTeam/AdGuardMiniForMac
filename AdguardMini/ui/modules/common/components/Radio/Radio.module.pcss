.Radio {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: var(--m-s);

    /* The native outline is replaced by the shared keyboard ring below. */
    outline: none;

    /*
     * Keyboard focus indicator: the label is the tab stop, so the ring wraps
     * the whole control. The contained preset keeps it inside the row.
     */
    --focus-ring-offset: var(--focus-ring-offset-contained);

    @mixin focus-ring;

     &:hover {            
        border-radius: 8px;
        background: var(--fills-backgrounds-page-background-hovered);
    }

    &_input {
        display: none;
    }

    &_handler {
        position: relative;
        vertical-align: top;
        color: var(--stroke-icons-gray-icons-default);

        &__checked {
            color: var(--stroke-icons-product-icon-default);
        }
    }

    &_label {
        user-select: none;
        text-align: left;
        margin-left: 14px;

        &__disabled {
            color: var(--text-main-text-main-disabled);
        }
    }

}
