.switch {
    display: block;
    cursor: pointer;
    display: flex;
    width: max-content;
    outline: none;

    /*
     * Keyboard focus indicator: the label is the tab stop, so the ring wraps
     * the toggle. The contained preset keeps it inside the row.
     */
    --focus-ring-offset: var(--focus-ring-offset-contained);

    @mixin focus-ring;

    &.disabledSwitch {
        cursor: default;

        &:hover,
        &:active {
            .disabled {
                border-color: var(--error-main-default);
                background-color: var(--error-main-default);
            }

            .enabled {
                border-color: var(--accent-main-default);
                background-color: var(--accent-main-default);
            }
        }
    }

    /* A switch waiting for the feature to run keeps the muted product green. */
    &.enablingSwitch {
        .labelEnabled {
            background-color: var(--accent-main-disabled);
            border-color: var(--accent-main-disabled);
        }
    }

    &:hover {
        .disabled {
            border-color: var(--error-main-hover);
            background-color: var(--error-main-hover);
        }

        .enabled {
            border-color: var(--accent-main-hover);
            background-color: var(--accent-main-hover);
        }
    }

    &:active {
        .label {
            outline: none;
        }

        .disabled {
            border-color: var(--error-main-pressed);
            background-color: var(--error-main-pressed);
        }

        .enabled {
            border-color: var(--accent-main-pressed);
            background-color: var(--accent-main-pressed);
        }
    }
}

.input {
    display: none;

    &.checked {
        & + .label {
            &.enabled {
                &::before {
                    left: 34px;
                }
            }
        }
    }

    &:disabled {
        & + .label {
            &::before {
                opacity: 0.5;
            }

            &.labelEnabled {
                background-color: var(--accent-main-disabled);
            }

            &.labelEnabled.muted {
                background-color: var(--neutral-dark-disabled);
            }

            &.labelDisabled {
                background-color: var(--neutral-light-disabled);
            }
        }
    }
}

.label {
    position: relative;
    display: block;
    width: 48px;
    height: 28px;
    border-radius: 20px;
    cursor: pointer;

    &::before {
        content: "";
        display: block;
        position: absolute;
        top: 1px;
        width: 26px;
        height: 26px;
        background-color: var(--special-static-white-default);
        border-radius: 50%;
    }
}

.labelDisabled {
    background-color: var(--neutral-light-default);

    &:hover {
        background-color: var(--neutral-light-hover);
    }

    &::before {
        left: 1px;
    }
}

.labelEnabled {
    background-color: var(--accent-main-default);

    &:hover {
        background-color: var(--accent-main-hover);
    }

    &::before {
        left: 21px;
    }
}

.labelTransitions {
    transition: background-color linear 0.3s;

    &::before {
        transition: left linear 0.3s, background-image linear 0.3s;
    }
}

.enabled,
.disabled {
    height: 30px;
    width: 80px;

    &::before {
        content: "";
        display: block;
        position: absolute;
        background-position: 50% 50%;
        /*
            CSS defaults to "repeat", which tiles the 19px icon across the
            50px knob.
        */
        background-repeat: no-repeat;
        background-color: var(--special-static-white-default);
        box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.15);
        width: 50px;
        height: 50px;
        top: -10px;
        left: -2px;
        /* z-index: var(--zi-above); */
    }
}

.enabled {
    background-color: var(--accent-main-default);
    border-color: var(--accent-main-default);

    &::before {
        background-image: url('./enabled.svg');
        background-size: 16px;
    }
}

.disabled {
    background-color: var(--error-main-default);
    border-color: var(--error-main-default);

    &:hover {
        & + .label {

            &::before {
                background-color: var(--special-static-white-default);
            }
        }
    }

    &::before {
        background-image: url('./disabled.svg');
        background-size: 13px;
    }
}

.muted {
    &.labelEnabled {
        background-color: var(--neutral-dark-default);
        border-color: var(--neutral-dark-default);
    }
}
