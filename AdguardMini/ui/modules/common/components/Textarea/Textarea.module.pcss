.Textarea {
    &_label {
        display: block;
        color: var(--neutral-dark-default);
        margin-bottom: var(--m-xxs);
    }

    &_container {
        position: relative;
        display: flex;
        border-radius: var(--border-radius);
        border: 1px solid var(--neutral-blend-default);
        background-color: var(--background-additional-default);
        width: auto;
        overflow: hidden;

        &__error {
            border-color: var(--error-main-default);
        }

        &:hover,
        &__focus {
            border-color: var(--neutral-light-default);
        }
    }

    &_textarea {
        display: block;
        flex: 1 1 auto;
        min-height: 0;
        position: relative;
        width: auto;
        border: 0;
        outline: none;
        resize: none;
        color: var(--neutral-black-default);
        box-sizing: border-box;
        overflow-y: auto;
        padding: var(--m-s);
        word-wrap: break-word;
        background-color: var(--background-additional-default);

        &::placeholder {
            color: var(--neutral-light-default);
        }
    }

    &_errorMessage {
        margin-top: var(--m-xxs);
        margin-bottom: var(--m-xxs);
        text-align: left;
        color: var(--error-main-default);
    }
}
