.Select {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--m-s);
    padding: var(--m-s);
    border: 1px solid var(--neutral-blend-default);
    border-radius: var(--border-radius);
    background-color: var(--background-additional-default);
    cursor: pointer;

    /* The border acts as the focus indicator, matching the Input component. */
    outline: none;

    &:hover,
    &:focus,
    &__active {
        border-color: var(--neutral-light-default);
    }

    &_label {
        display: block;
        color: var(--neutral-dark-default);
        margin-bottom: var(--m-xxs);
    }

    &_value {
        flex: 1 0 0;
        min-width: 1px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--neutral-black-default);
    }

    &_arrow {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        transform: rotate(-90deg);
        color: var(--neutral-dark-default);
    }

    &_options {
        visibility: hidden;
        position: fixed;
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
        background: var(--background-elevated-default);
        border-radius: var(--border-radius);
        box-shadow: var(--bs-big);
        z-index: var(--zi-tooltip);
        max-height: 300px;
        overflow-y: auto;

        &__show {
            visibility: visible;
        }
    }

    &_option {
        display: flex;
        align-items: center;
        gap: var(--m-s);
        padding: var(--m-s);
        cursor: pointer;

        &:not(:first-child) {
            border-top: 1px solid var(--neutral-blend-default);
        }

        &__highlighted {
            background: var(--background-elevated-hover);
        }

        &__selected {
            background: var(--background-elevated-hover);

            & .Select_optionLabel {
                font-weight: var(--fw-semibold);
            }
        }
    }

    &_optionLabel {
        flex: 1 0 0;
        min-width: 1px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--neutral-black-default);
    }

    &_check {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        color: var(--accent-main-default);
    }
}
