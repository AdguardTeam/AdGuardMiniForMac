.Checkbox {
    cursor: pointer;
    position: relative;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-user-select: none;
    display: block;

    &_withHover {
        padding: var(--m-s);

        &:hover {            
            border-radius: 8px;
            background: var(--fills-backgrounds-page-background-hovered);
        }
    }

    &_title {
        display: flex;
        align-items: center;
        gap: var(--m-xs);
    }

    &_desc {
        margin-left: 36px;
        margin-top: 2px;
    }


    &__disabled {
        cursor: default;
    }

    &_input {
        display: none;
        outline: none;
    }

    &_handler {
        width: 24px;
        height: 24px;
        position: relative;
        flex-shrink: 0;
    }

    &_input:disabled + &_handler {
        opacity: 0.4;
    }
}
