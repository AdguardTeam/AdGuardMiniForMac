.ExternalLink {
    text-decoration-line: underline;
    display: inline-block;
    width: max-content;
    transition: color linear 0.3s, text-decoration-color linear 0.3s;

    &:hover {
        text-decoration: none;
    }

    &:visited {
        color: initial;
    }

    &_text {
        color: inherit;
    }

    &__inheritColor {
        color: inherit;
        text-decoration-color: inherit;
    }

    &__green {
        color: var(--text-links-link-default);
        text-decoration-color: var(--text-links-link-default);

        &:hover {
            color: var(--text-links-link-hovered);
            text-decoration-color: var(--text-links-link-hovered);
        }
    }

    &__red {
        color: var(--text-links-error-link-default);
        text-decoration-color: var(--text-links-error-link-default);

        &:hover {
            color: var(--text-links-error-link-hovered);
            text-decoration-color: var(--text-links-error-link-hovered);
        }
    }

    &__noUnderline {
        text-decoration: none;
    }
}