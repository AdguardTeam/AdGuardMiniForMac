.Input {

    &_label {
        display: block;
        color: var(--neutral-dark-default);
        margin-bottom: var(--m-xxs);
    }

    &_container {
        position: relative;
        display: flex;
        align-items: center;
        box-sizing: border-box;
        min-height: 56px;
        cursor: pointer;

        border: 1px solid var(--neutral-blend-default);
        background-color: var(--background-additional-default);
        border-radius: 8px;
        width: auto;

        padding: var(--m-s);

        &:hover,
        &__focus {
            border-color: var(--neutral-light-default);
        }

        &__allowClear {
            padding-right: var(--m-xl);
        }
    }

    &__error {
        border: 1px solid var(--error-main-default);
    }

    &__invalid {
        border: 1px solid var(--error-main-default);
    }

    &__disabled {
        &_input {
            color: var(--neutral-light-default);
        }
    }

    &_input {
        display: block;
        flex: 1 1 auto;
        min-width: 0;

        width: 100%;
        height: 24px;
        padding: 0;

        border: 0;
        border-radius: 0;
        line-height: var(--lh-m);

        background-color: transparent;
        color: var(--neutral-black-default);

        /* The container's focus border is the focus indicator; drop the native outline. */
        outline: none;

        /* Placeholder text only; typed text keeps the main text color. */
        &::placeholder {
            color: var(--neutral-light-default);
        }
    }

    &_clear {
        position: absolute;
        top: var(--m-s);
        right: var(--m-s);
        display: flex;
        align-items: center;
        justify-content: center;
        height: var(--m-m);
        width: var(--m-m);
        padding: 0;
        border: none;
        background: none;
        cursor: pointer;
        z-index: var(--zi-above-extra);

        /* Small floating control: the ring sits clear of the glyph. */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;

        &:disabled {
            cursor: default;
        }
    }

    &_cross {
        color: var(--neutral-dark-default);
    }

    &_errorMessage {
        margin-top: var(--m-xxs);
        margin-bottom: var(--m-xxs);
        text-align: left;
        color: var(--error-main-default);
    }
}

