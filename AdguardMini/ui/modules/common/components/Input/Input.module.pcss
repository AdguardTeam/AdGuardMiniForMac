.Input {

    &_label {
        display: block;
        color: var(--text-lables-labels-default);
        margin-bottom: var(--m-xxs);
    }

    &_container {
        position: relative;
        display: flex;
        align-items: center;
        box-sizing: border-box;
        min-height: 56px;

        border: 1px solid var(--stroke-inputs-inactive-input-stroke-default);
        background-color: var(--fills-inputs-input-background-default);
        border-radius: 8px;
        width: auto;

        padding: var(--m-s);

        &__focus {
            border-color: var(--stroke-inputs-active-input-stroke-default);
        }

        &__allowClear {
            padding-right: var(--m-xl);
        }
    }

    &__error {
        border: 1px solid var(--text-links-error-link-default);
    }

    &__invalid {
        border: 1px solid var(--text-links-error-link-default);
    }

    &__disabled {
        &_input {
            color: var(--text-placeholder-placeholder-default);
        }
    }

    &_input {
        display: block;
        flex: 1 1 auto;
        min-width: 0;

        width: 100%;
        height: 24px;
        padding: 0;

        border: 0;
        border-radius: 0;
        line-height: var(--lh-m);

        background-color: transparent;
        color: var(--text-main-text-main-default);

        /* The container's focus border is the focus indicator; drop the native outline. */
        outline: none;

        /* Placeholder text only; typed text keeps the main text color. */
        &::placeholder {
            color: var(--text-placeholder-placeholder-default);
        }
    }

    &_clear {
        position: absolute;
        top: var(--m-s);
        right: var(--m-s);
        cursor: pointer;
        height: var(--m-m);
        width: var(--m-m);
        z-index: var(--zi-above-extra);
    }

    &_cross {
        color: var(--stroke-icons-gray-icons-default);
        cursor: pointer;
    }

    &_errorMessage {
        margin-top: var(--m-xxs);
        margin-bottom: var(--m-xxs);
        text-align: left;
        color: var(--text-links-error-link-default);
    }
}

