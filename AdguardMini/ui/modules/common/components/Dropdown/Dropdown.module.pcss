.Dropdown {
    background-color: var(--background-additional-default);
    position: relative;
    border-radius: 8px;
    width: inherit;
    height: var(--m-xxxl);
    border: 1px solid var(--neutral-blend-default);
    box-sizing: content-box;
    height: 54px;

    &:hover,
    &__active {
        border-color: var(--neutral-light-default);
    }

    &_label {
        display: block;
        color: var(--neutral-black-default);
        margin-bottom: var(--m-xxs);
    }

    &_arrow {
        transform: rotate(-90deg);
        width: 24px;
        height: 24px;
        color: var(--neutral-dark-default);
    }

    &__disabled {
        opacity: 0.5;
    }

    &_header {
        padding: 16px 16px 10px;
        display: flex;
        justify-content: space-between;
        width: auto;
        cursor: pointer;
        box-sizing: content-box;

        /* The native outline is replaced by the shared keyboard ring below. */
        outline: none;

        /*
         * Ring-offset adaptation: the reference maps its dropdown header to
         * the default offset on a header carrying `border-radius: 8px`; our
         * header has no radius and sits flush inside the rounded, bordered
         * `.Dropdown` frame, so an offset-0 ring would cross the frame
         * border. The 2px inset keeps the ring inside the frame.
         */
        --focus-ring-offset: var(--focus-ring-offset-contained);

        @mixin focus-ring;
    }

    &_text {
        display: flex;
        width: calc(100% - 24px);
    }

    &_multiLabel {
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
        width: auto;
    }

    &_options {
        visibility: hidden;
        position: fixed;
        background: var(--background-elevated-default);
        list-style: none;
        padding: 0;
        box-shadow: 8px 8px 24px 0px rgba(0, 0, 0, 0.10);
        z-index: var(--zi-above-extra);
        border-radius: 8px;
        max-height: 300px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;

        &__show {
            visibility: visible;
        }
    }

    &_option {
        padding: var(--m-s);
        cursor: pointer;
        height: 24px;
        box-sizing: content-box;

        &:not(:first-child) {
            border-top: 1px solid var(--neutral-blend-default);
        }
    
        &:hover:not(&__selected) {
            background: var(--background-additional-default);
        }
    }
}
