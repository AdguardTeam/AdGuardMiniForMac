.Button {
    cursor: pointer;
    text-decoration: none;
    /* The native outline is replaced by the shared keyboard ring below. */
    outline: none;
    padding: 0;
    display: block;
    text-align: center;
    border: 0px solid transparent;
    border-radius: var(--border-radius);
    transition: background-color linear 0.1s,
                border-color linear 0.1s,
                color linear 0.1s;

    /*
     * Local pin: the ring is flush with the control (offset 0), and the
     * explicit value stops a nested button from inheriting an ancestor's
     * local offset (e.g. the contained value on `.SettingsItem`).
     */
    --focus-ring-offset: 0px;

    @mixin focus-ring;

    &:disabled {
        opacity: .5;
    }

    &__icon {
        width: 24px;
        height: 24px;
        background: none;
    }

    &__iconSmall {
        width: 16px;
        height: 16px;
    }

    /*
     * Design-system button labels are semibold; the `Text` typography class
     * sets a normal weight, so it is overridden once for the button types
     * instead of at every call site. Text-like and filled buttons keep the
     * regular weight.
     */
    &__submit > *,
    &__outlined > * {
        font-weight: var(--fw-semibold);
    }

    &__submit {
        width: 100%;
        min-height: 56px;
        padding: var(--m-s);
        border-radius: var(--border-radius);
        text-align: center;
        color: var(--special-static-white-default);
        max-width: 278px;
    }

    &__outlined {
        background: none;
        width: 100%;
        min-height: 56px;
        padding: var(--m-s);
        border-radius: var(--border-radius);
        border: 1px solid var(--neutral-dark-default);
        text-align: center;
        background-color: var(--background-main-default);
        color: var(--neutral-black-default);
        max-width: 278px;

        &:hover {
            background-color: var(--background-main-hover);
        }
    }

    &__filled {
        background: none;
        width: 100%;
        padding: var(--m-xxs);
        height: 16px;
        border-radius: var(--border-radius);
        text-align: center;
    }

    &__text {
        background: transparent;
        color: var(--accent-main-default);
        &:hover {
            color: var(--accent-main-hover);
        }
    }
    &__small {
        padding: var(--m-xs) var(--m-xs);
    }
}

