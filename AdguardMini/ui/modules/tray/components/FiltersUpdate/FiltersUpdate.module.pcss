.FiltersUpdate {
    overflow: auto;
    width: 360px;
    height: 582px;
    background: var(--background-main-default);
    box-shadow: var(--bs-big);
    box-sizing: content-box;

    &_header {
        display: flex;
        padding: var(--m-m);
    }

    &_title {
        text-align: left;
        margin-top: var(--m-l);
        margin-bottom: var(--m-xs);
    }

    &_filter {
        padding: var(--m-xxs) var(--m-s);
        border-bottom: 1px solid var(--neutral-blend-default);
        display: flex;

        &:last-of-type {
            border-bottom: 0;
        }

        &_name {
            margin-right: auto;
        }

        &__orange {
            color: var(--attention-main-default)
        }
    }
}
