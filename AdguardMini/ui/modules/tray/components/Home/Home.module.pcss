.Home {
    display: flex;
    flex-direction: column;
    width: 360px;
    height: 582px;
    background: var(--background-main-default);
    box-shadow: var(--bs-big);
    box-sizing: content-box;
    overflow: hidden;

    &_header {
        display: flex;
        width: auto;
        padding: var(--m-m) var(--m-s);

        &_logo {
            width: 146px;
        }

        &_update {
            margin-left: auto;
            margin-right: var(--m-s);
        }

        &_tooltipWrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        &_tooltip {
            position: absolute;
            top: calc(100% + var(--m-xxxs));
            right: 0;
            z-index: var(--zi-tooltip);
            display: none;
            padding: var(--m-s);
            border-radius: var(--border-radius);
            background: var(--background-main-default);
            color: var(--neutral-black-default);
            box-shadow: var(--bs-small);
            font-size: var(--ft-m);
            line-height: var(--lh-m);
            white-space: nowrap;
            pointer-events: none;
        }

        &_tooltipWrap:hover &_tooltip,
        &_tooltipWrap:focus-within &_tooltip {
            display: block;
        }
    }

    &_title {
        margin-top: var(--m-xxl);
        margin-bottom: var(--m-xs);
        text-align: center;
        display: block;
    }

    &_status {
        text-align: center;
        color: var(--neutral-dark-default);
        padding: 0 var(--m-xs);
    }

    &_extensionsDisabled {
        color: var(--attention-main-default);
    }

    &_link {
        display: inline;
        text-decoration: underline;
        cursor: pointer;
        font-size: var(--ft-m) !important;
        color: inherit;

        /*
         * Keyboard focus indicator: an inline, link-styled text action, so
         * the floating offset keeps the ring clear of the text.
         */
        --focus-ring-offset: var(--focus-ring-offset-floating);

        @mixin focus-ring;
    }
    &_switch {
        margin: 62px auto auto;
    }

    &_storiesControls {
        display: flex;
        margin-bottom: var(--m-m);
        margin-left: var(--m-s);
        margin-right: var(--m-s);
        align-items: center;

        &_title {
            margin-right: auto;
        }

        &_button {
            &__right {
                transform: rotate(180deg);
                margin-left: var(--m-s);
            }
            &__disabled {
                color: var(--neutral-blend-default);
            }
        }

    }
    &_stories {
        overflow-x: scroll;
        align-self: baseline;
        width: 344px;
        margin-left: var(--m-s);
        margin-bottom: var(--m-s);

        scrollbar-width: none;

        &::-webkit-scrollbar {
            display: none;
        }

        &_container {
            display: flex;
        }
    }

    &_loader {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100vw;
    }
}
