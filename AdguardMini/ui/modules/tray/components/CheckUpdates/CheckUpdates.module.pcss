.CheckUpdates {
    width: 360px;
    height: 582px;
    background: var(--background-main-default);
    box-shadow: var(--bs-big);
    box-sizing: content-box;

    &_header {
        display: flex;
        padding: var(--m-m);
    }

    &_title {
        text-align: left;
        margin-top: var(--m-l);
        margin-bottom: var(--m-xs);
    }

    &_desc {
        text-align: left;
        margin-bottom: var(--m-s);
        color: var(--neutral-dark-default);
    }

    &_element {
        color: var(--neutral-dark-default);

        border-bottom: 1px solid var(--neutral-blend-default);

        &:last-of-type {
            border-bottom: 0;
        }

        &_arrow {
            transform: rotate(180deg);
            color: var(--neutral-dark-default);
            margin-left: auto;
        }

        &_title {
            padding: var(--m-s);
            display: flex;

            /*
             * Keyboard focus indicator: the row is a tab stop only while it
             * is an actionable "button" (`filtersHoverable`), so the ring
             * never decorates the read-only status row; the contained preset
             * keeps it inside the bordered list row.
             */
            --focus-ring-offset: var(--focus-ring-offset-contained);

            @mixin focus-ring;

             &__hover {
                cursor: pointer;

                &:hover {
                    background-color: var(--background-main-hover);
                }
            }

            &_icon {
                margin-right: var(--m-xs);
                margin-top: 0;

                &__updated {
                    color: var(--accent-main-default);
                }

                &__info {
                    color: var(--attention-main-default);
                }

            }

            &_text {
                margin-bottom: var(--m-xxxs);
                color: var(--neutral-black-default);
            }

            &_link {
                display: inline;
                cursor: pointer;
                text-decoration: underline;
            }

            &_fix {
                color: var(--attention-main-default);
            }
        }

        &_button {
            margin: var(--m-xxs) auto;
            max-width: 328px;

            &_text {
                line-height: var(--m-m);
            }
        }
    }
}