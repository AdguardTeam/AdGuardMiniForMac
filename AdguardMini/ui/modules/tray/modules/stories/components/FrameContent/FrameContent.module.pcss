.FrameContent {
    width: 360px;
    height: 510px;
    display: flex;
    flex-direction: column;

    &_image {
        background-size: contain;
        background-position: center;
        max-height: 300px;
        background-repeat: no-repeat;
        flex: 1;

        &__small {
            max-height: 236px;
        }

        &__big {
            max-height: 300px;
        }
    }

    &_imageText {
        max-height: 300px;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--special-static-white-default);
    }

    &_title {
        margin: var(--m-s) var(--m-s) var(--m-xs);
        color: var(--special-static-white-default);
        text-align: center;
        position: relative;
        z-index: 3;
    }

    &_description {
        margin: 0 var(--m-s) var(--m-s);
        color: var(--special-static-white-default);
        text-align: center;
        position: relative;
        z-index: 3;
    }

    &_button {
        box-sizing: border-box;
        width: 328px;
        max-width: 328px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: var(--m-xxs) auto;
        color: #3D3D3D;
        background-color: var(--special-static-white-default);
        z-index: 5;
        position: relative;
    }

    &_buttonSecondary {
        box-sizing: border-box;
        width: 360px;
        max-width: 360px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        z-index: 5;
        position: relative;
    }
}
