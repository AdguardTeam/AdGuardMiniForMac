.StoryCard {
    position: relative;
    width: 108px;
    height: 116px;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    /*
        Cards are flex items inside the horizontally scrolling carousel.
        Standard CSS shrinks flex items by default (unlike Sciter), which
        squeezed the cards below their 140px design width (Figma: 140x148).
    */
    flex-shrink: 0;
    border-radius: var(--border-radius);
    padding: var(--m-s);
    margin-bottom: var(--m-xxs);
    margin-right: var(--m-s);
    box-shadow: var(--bs-small);
    cursor: pointer;
    background: var(--fills-backgrounds-cards-background-default);
    transition: background-color linear 0.3s;

    &:hover {
        background: var(--fills-backgrounds-cards-background-hovered);
    }

    &:active {
        background: var(--fills-backgrounds-cards-background-pressed);
    }


    &__warning {
        border: 1px solid var(--stroke-dividers-item-divider-orange-default);
        background: var(--fills-notifications-orange-default);

        &:hover {
            background: var(--fills-notifications-orange-default);
        }

        &:active {
            background: var(--fills-notifications-orange-default);
        }
    }

    &_header {
        display: flex;
        vertical-align: middle;
    }

    &_body {
        display: flex;
        flex-direction: column;
        margin-top: var(--m-xs);
    }

    &_icon {
        color: var(--stroke-icons-product-icon-default);

        &__warning {
            color: var(--stroke-icons-attention-icon-default);
        }

        &__redIcon {
            color: var(--text-links-error-link-default);
        }

        &__orangeIcon {
            color: var(--stroke-icons-attention-icon-default);
        }
    }

    &_hideText {
        margin-left: auto;
        color: var(--text-placeholder-placeholder-default);
    }
}
