.StoryCard {
    position: relative;
    width: 108px;
    height: 116px;
    box-sizing: content-box;
    display: flex;
    flex-direction: column;
    /*
        Cards are flex items inside the horizontally scrolling carousel.
        Flex items shrink by default, which squeezed the cards below their
        140px design width (Figma: 140x148).
    */
    flex-shrink: 0;
    border-radius: var(--border-radius);
    padding: var(--m-s);
    margin-bottom: var(--m-xxs);
    margin-right: var(--m-s);
    box-shadow: var(--bs-small);
    cursor: pointer;
    background: var(--background-elevated-default);

    &:hover {
        background: var(--background-elevated-hover);
    }

    &:active {
        background: var(--background-elevated-pressed);
    }

    @mixin focus-ring;

    &__warning {
        border: 1px solid var(--attention-main-default);
        background: var(--attention-blend-default);

        &:hover {
            background: var(--attention-blend-default);
        }

        &:active {
            background: var(--attention-blend-default);
        }
    }

    &_header {
        display: flex;
        vertical-align: middle;
    }

    &_body {
        display: flex;
        flex-direction: column;
        margin-top: var(--m-xs);
    }

    &_icon {
        color: var(--accent-main-default);

        &__warning {
            color: var(--attention-main-default);
        }

        &__redIcon {
            color: var(--error-main-default);
        }

        &__orangeIcon {
            color: var(--attention-main-default);
        }
    }

    &_hideText {
        margin-left: auto;
        color: var(--neutral-light-default);
    }
}
