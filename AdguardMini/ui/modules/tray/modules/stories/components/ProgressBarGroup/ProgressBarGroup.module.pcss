.ProgressBar {
    box-sizing: content-box;
    width: auto;
    margin: var(--m-m) var(--m-s);
    position: relative;
    z-index: 5;

    display: flex;

    &_close {
        margin-left: var(--m-xxs);
        z-index: 5;

        &__solo {
            margin-left: auto;
        }
    }
}
