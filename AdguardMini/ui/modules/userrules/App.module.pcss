.App {
    --app-padding-top: 32px;
    --title-line-height: calc(1.2 * 24px);
    --header-margin-bottom: 16px;
    --editor-margin-bottom: 16px;
    --button-min-height: 56px;
    --app-padding-bottom: 36px;

    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--app-padding-top) 40px var(--app-padding-bottom);

    &_header {
        display: flex;
        margin-bottom: var(--header-margin-bottom);
        align-items: center;
        user-select: none;
        -webkit-user-select: none;
        cursor: default !important;

        &_title {
            font-weight: 700;
            font-size: 24px;
            line-height: var(--title-line-height);
            color: var(--neutral-black-default);
            margin-right: auto;
        }

        &_subtitle {
            font-weight: 400;
            font-size: 16px;
            line-height: 130%;
            margin: 0 16px;

            /*
             * Keyboard focus indicator: an inline, link-styled text action,
             * so the floating offset keeps the ring clear of the text.
             */
            --focus-ring-offset: var(--focus-ring-offset-floating);

            @mixin focus-ring;
        }

        &_hotkeys {
            position: relative;
            display: flex;
            align-items: center;
            margin-left: 16px;

            &_label {
                margin-right: 4px;
                display: flex;
                align-items: center;
                gap: 2px;
            }

            &_popup {
                display: none;
                position: absolute;
                top: 28px;
                right: 16px;
                z-index: 10;
                min-width: 227px;
                padding: 16px;
                color: var(--neutral-black-default);
                background-color: var(--background-main-default);
                border-radius: var(--border-radius);
                box-shadow: 4px 4px 8px 0px rgba(0, 0, 0, 0.10);

                &_title {
                    font-size: 16px;
                    line-height: 20px;
                    font-weight: 600;
                    margin-bottom: 16px;
                }

                &_item {
                    font-size: 12px;
                    line-height: 16px;
                    &_hotkey {
                        font-weight: 600;
                    }
                }
            }

            &:hover {
                .App_header_hotkeys_popup {
                    display: block;
                }
            }
        }
    }

    &_loader {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-bottom: 16px;
        border: 1px solid var(--neutral-blend-default);
        height: calc(100% 
            - var(--app-padding-top) 
            - var(--title-line-height) 
            - var(--header-margin-bottom) 
            - var(--editor-margin-bottom) 
            - var(--button-min-height) 
            - var(--app-padding-bottom));
    }

    &_editor {
        flex: 1 1 auto;
        min-height: 0;
        margin-bottom: var(--editor-margin-bottom);
        border: 1px solid var(--neutral-blend-default);
    }

    &_row {
        display: flex;
        gap: 16px;
        align-items: center;
        user-select: none;
        -webkit-user-select: none;

        &_btn {
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            min-width: 288px;
            min-height: 56px;
            padding: 0 16px;
            position: relative;

            /*
             * Keyboard focus indicator: a standard button, so the ring is
             * flush with its edge (offset 0).
             */
            @mixin focus-ring;

            color: var(--special-static-white-default);
            background-color: var(--accent-main-default);
            
            &:hover {
                background-color: var(--accent-main-hover);
            }

            &:active {
                background-color: var(--accent-main-pressed); 
            }

            &:disabled {
                cursor: default;
                background-color: var(--accent-main-disabled);
            }

            &_text {
                margin: 0 auto;
            }

            &_loader {
                position: absolute;
                top: 16px;
                right: 16px;
            }

            &__loading {
                color: var(--special-static-white-disabled);
                background-color: var(--accent-main-disabled) !important;
            }
        }

        &_hint {
            flex: 1 1 auto;
            color: var(--attention-main-default);

            &__saved {
                color: var(--neutral-light-default);
            }

            &_action {
                padding: 0;
                border: none;
                background: none;
                font: inherit;
                color: inherit;
                cursor: pointer;

                /*
                 * Keyboard focus indicator: an inline text action, so the
                 * floating offset keeps the ring clear of the text.
                 */
                --focus-ring-offset: var(--focus-ring-offset-floating);

                @mixin focus-ring;

                &:hover {
                    text-decoration: underline;
                }
            }
        }
    }

    &__link {
        color: var(--accent-main-default);
        cursor: pointer;
    }

    &_ContextMenu {
        position: relative;
        margin-left: 16px;
        width: 24px;
        height: 24px;
        cursor: pointer;

        &_icon {
            color: var(--neutral-dark-default);
        }

        &:hover {
            .App_ContextMenu_context {
                display: block;
            }
        }

        &_context {
            z-index: var(--zi-tooltip);
            position: absolute;
            display: none;
            width: max-content;
            border-radius: var(--border-radius);
            background-color: var(--background-elevated-default);
            right: 0px;
            top: 30px;
            box-shadow: var(--bs-big);
            overflow: hidden;
        }

        &_action {
            padding: 15px var(--m-s) 9px;
            box-sizing: content-box;
            cursor: pointer;
            min-height: 26px;
        }
    }
}

:global(html) {
    color-scheme: light dark;
}

:global(#app) {
    height: 100%;
}
