/* {{constants.COMMON_GENERATED_FILES_PREAMBLE}} */
{% set types = [] %}
{% for method in service.methods %}
{% do types.append(method.request_message_type) %}
{% do types.append(method.response_message_type) %}
{% endfor %}
import {
{%- for type in types | unique %}
 {{type}}{{ ' ' if loop.last else ',' }}
{%- endfor %}
} from '../types'

/* {{helper.wrap_string(service.description, " * ")}}- public part for external platform calls with methods for {{config["array_buffer_type_name"]}} */
export interface I{{service.name}} {
{% for method in service.methods %}
	/* {{helper.wrap_string(method.description, "	 * ")}} */
	{{method.name}}({{config["param_name"]}}: {{config["array_buffer_type_name"]}}): Promise<{{method.response_message_type}}>;
{% endfor %}
}

/* {{helper.wrap_string(service.description, " * ")}}- private part for operations with unmarshalled params */
export interface I{{service.name}}Internal {
{% for method in service.methods %}
	/* {{helper.wrap_string(method.description, "	 * ")}}*/
	{{method.name}}({{config["param_name"]}}: {{method.request_message_type}}): Promise<{{method.response_message_type}}>;
{% endfor %}
}

{% set serviceInternalFieldName = helper.pascal_to_camel(service.name) + "Internal" %}
/* {{helper.wrap_string(service.description, " * ")}} */
export class {{service.name}} implements I{{service.name}} {
	{{serviceInternalFieldName}}: I{{service.name}}Internal;

	constructor({{serviceInternalFieldName}}: I{{service.name}}Internal) {
		this.{{serviceInternalFieldName}} = {{serviceInternalFieldName}}
	}

{% for method in service.methods %}
	/**
	 * {{helper.wrap_string(method.description, "	 * ")}}
	 * @param {{config["array_buffer_type_name"]}} {{config["param_name"]}}
	 * @returns {{method.response_message_type}} {{config["param_name"]}}
	 */
	{{method.name}} = async ({{config["param_name"]}}: {{config["array_buffer_type_name"]}}): Promise<{{method.response_message_type}}> => {
		const bytes = new Uint8Array({{config["param_name"]}});
		const arg = {{method.request_message_type}}.deserializeBinary(bytes);

		if (!arg) {
			throw new Error(`Empty parameter in {{service.name}}.{{method.name}}: ${ {{config["param_name"]}} }`);
		}
		window.log?.dbg('Callback data', '{{service.name}}.{{method.name}}', arg.toObject());
		await this.{{serviceInternalFieldName}}.{{method.name}}(arg);
		return new {{method.response_message_type}}();
	};
{% endfor %}
}

