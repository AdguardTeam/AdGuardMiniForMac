		log.dbg('Request data', '{{service.body.name}}.{{method.body.name}}', {{config["param_name"]}}.toObject());

		const {{config["res_name"]}} = await {{config["xcall_method_name"]}}('{{service.body.name}}.{{method.body.name}}', {{config["param_name"]}}.serializeBinary().buffer);
