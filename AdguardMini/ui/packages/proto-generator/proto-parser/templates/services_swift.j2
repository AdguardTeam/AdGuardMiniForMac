/// {{constants.COMMON_GENERATED_FILES_PREAMBLE}}

import Foundation
import SwiftProtobuf

// WKWebView-only service bridge.

// MARK: Protocol definition

/// {{helper.wrap_string(service.description, "/// ")}}
/// YOU MUST IMPLEMENT THIS PROTOCOL USING CLASS WITH TYPE `{{service.name}}.ServiceType` IN SEPARATE SOURCE FILE
public protocol {{service.name}}Protocol
{
{% for method in service.methods %}
	/// {{helper.wrap_string(method.description, "	/// ")}}
	func {{helper.pascal_to_camel(method.name)}} (
						_ message: {{method.request_message_type}},
						_ promise: sending @escaping ({{method.response_message_type}}) -> Void) -> Void
{% endfor %}
}

// MARK: Protobuf Bridge definition
// Base class for `{{service.name}}.ServiceType`.

/// {{helper.wrap_string(service.description, "	/// ")}}
open class {{service.name}}: {{config["service_class_name"]}}
{
	public override var serviceName: String { "{{service.name}}" }
	public typealias ServiceType = {{service.name}} & {{config["service_protocol"]}} & {{service.name}}Protocol

	/// WKWebView dispatch entry.
	public override func handleRequest(method: String, bytes: Data, promise: sending @escaping (Data) -> Void) {
		switch method {
{% for method in service.methods %}
		case "{{method.name}}":
			do {
				let input = try {{method.request_message_type}}(serializedBytes: bytes)
				cast.{{helper.pascal_to_camel(method.name)}}(input) { result in
					do {
						promise(try result.serializedData())
					} catch {
						BridgeLog.error("{{service.name}}.{{method.name}}: failed to serialize reply: \(error)")
						promise(Data())
					}
				}
			} catch {
				BridgeLog.error("{{service.name}}.{{method.name}}: failed to deserialize request: \(error)")
				promise(Data())
			}
{% endfor %}
		default:
			BridgeLog.error("{{service.name}}.handleRequest: unknown method \"\(method)\"")
			promise(Data())
		}
	}

	private var cast : ServiceType
	{
		if let service = self as? ServiceType {
			return service
		}

		fatalError("{{service.name}} instance must conform to its ServiceType protocol")
	}
}
