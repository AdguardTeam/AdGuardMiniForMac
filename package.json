{
  "name": "adguard-mini",
  "version": "2.0.0.rc",
  "description": "Part of AdGuard Mini swift app responsible for displaying of data for user",
  "author": "AdGuard Team",
  "license": "GPL-3.0-or-later",
  "private": true,
  "workspaces": [
    "AdguardMini/ui/packages/*"
  ],
  "nodemonConfig": {
    "watch": [
      "AdguardMini/MiniResources/WebUI"
    ],
    "delay": 1500,
    "ext": "html,css,js,svg,json",
    "ignore": [
      "**/*.map"
    ]
  },
  "scripts": {
    "start": "yarn esbuild:start",
    "build:dev": "yarn esbuild:dev",
    "build:prod": "yarn esbuild:prod",
    "esbuild:start": "node ./AdguardMini/ui/scripts/esbuild/esbuild.config.dev.js --watch",
    "esbuild:dev": "node ./AdguardMini/ui/scripts/esbuild/esbuild.config.dev.js",
    "esbuild:prod": "node ./AdguardMini/ui/scripts/esbuild/esbuild.config.prod.js",
    "lint:fix": "yarn lint --fix --quiet",
    "prepare": "husky install",
    "lint": "eslint -c ./AdguardMini/ui/scripts/lint/prod.mjs --ext .tsx,.ts ./AdguardMini/ui/",
    "typecheck": "sciter-infra-utils typecheck",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "locales:exist": "sciter-infra-utils locales-exist ./AdguardMini/ui/modules/common/intl/index.ts",
    "locales:check": "sciter-infra-utils locales-check ./AdguardMini/ui",
    "locales:checkInhouse": "sciter-infra-utils locales-check ./AdguardMini/ui --inhouse-only --no-check-unused-keys --no-check-files-existence",
    "locales:pull": "sciter-infra-utils locales-pull",
    "locales:pushMaster": "sciter-infra-utils locales-push",
    "theme:generate": "node ./AdguardMini/ui/scripts/theme/vendored-tokens.mjs",
    "watchProject": "nodemon --exec './AdguardMini/Scripts/syncWebUI.sh --no-build'",
    "syncUI": "./AdguardMini/Scripts/syncWebUI.sh",
    "svgo:optimize": "svgo -f AdguardMini/ui -r --config svgo.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@adg/rules-builder": "0.1.0",
    "@adg/webview-utils-kit": "0.7.0",
    "@adguard/rules-editor": "^2.0.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "classix": "^2.1.32",
    "date-fns": "^4.1.0",
    "is-valid-domain": "^0.1.6",
    "lodash": "^4.17.21",
    "lottie-web": "^5.12.2",
    "mobx": "^6.9.0",
    "mobx-react-lite": "^3.4.3",
    "preact": "^10.15.1",
    "qs": "^6.11.2",
    "uuid": "^9.0.0",
    "vscode-oniguruma": "^2.0.1"
  },
  "devDependencies": {
    "@adg/proto-generator": "^1.8.0",
    "@adg/sciter-infra-utils": "0.24.0",
    "@stylistic/eslint-plugin": "^5.2.0",
    "@types/google-protobuf": "^3.15.5",
    "@types/lodash": "^4.17.6",
    "@types/node": "^22.15.3",
    "@types/qs": "^6.9.8",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitest/coverage-v8": "4.1.11",
    "chalk": "^4.1.2",
    "esbuild": "0.27.2",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lodash": "^7.4.0",
    "eslint-plugin-mobx": "^0.0.13",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fs-extra": "11.4.1",
    "globals": "^14.0.0",
    "google-protobuf": "^3.21.2",
    "husky": "^8.0.3",
    "jsdom": "^29.0.1",
    "lint-staged": "^13.2.1",
    "nodemon": "^2.0.22",
    "postcss-mixins": "8.1.0",
    "postcss-nested": "^6.0.1",
    "svgo": "4.1.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "4.1.11"
  }
}
