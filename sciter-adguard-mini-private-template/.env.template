# Private environment for AdGuard Mini development.
# Copy this file to `.env` in the `sciter-adguard-mini-private` directory and
# fill in the values below. It is consumed by `configure.sh`.

# URL of the private Swift package registry that serves the `mac`-scoped
# packages (mac.sp-backend, mac.sp-sciter-sdk, mac.aml, ...).
SWIFT_REGISTRY_URL=

# Git URL of the `support-scripts` repository, cloned by `configure.sh dev`.
SUPPORT_SCRIPTS_GIT=

# Backend request keys used to generate `configuration/PrivateConfig.xcconfig`.
# Leave empty to fall back to dummy values (for builds that do not talk to the
# real backend).
CONFIG_BACKEND_REQUEST_KEY=
CONFIG_BACKEND_REQUEST_ENCRYPTION_KEY=
